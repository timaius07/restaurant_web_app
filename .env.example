# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de bootstrapping ÚNICAMENTE
#
# ⚠️  Este proyecto usa Infisical para gestionar secretos en build time.
#     Los secretos con prefijo "F_" en Infisical se inyectan automáticamente
#     como import.meta.env.VITE_* durante el build de Vite.
#
#     Ejemplo en Infisical:  F_API_URL=https://api.tudominio.com
#     Acceso en el código:   import.meta.env.VITE_API_URL
#
# Pasos para configurar el entorno local:
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena los 3 valores de Infisical con los de tu Machine Identity
#   3. NO agregues más variables aquí — viven en Infisical con prefijo F_
# ─────────────────────────────────────────────────────────────────────────────

# ── Bootstrapping de Infisical ────────────────────────────────────────────────
# Obtén estos valores en: app.infisical.com → tu proyecto → Access Control → Machine Identities
INFISICAL_CLIENT_ID=client_id
INFISICAL_CLIENT_SECRET=client_secret
INFISICAL_PROJECT_ID=project_id

# ── Entorno ───────────────────────────────────────────────────────────────────
# "development" → carga entorno "dev" de Infisical
# "production"  → carga entorno "prod" de Infisical
NODE_ENV=development
